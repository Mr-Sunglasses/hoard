# Copy to .env and fill in. Everything is optional except PUID/PGID.

# The user and group that own your models folder (run `id -u` and `id -g`).
PUID=1000
PGID=1000

# Password for the web UI (any username). Strongly recommended.
APP_PASSWORD=

# Hugging Face token for gated/private models. You can also add one in the UI instead.
HF_TOKEN=

# Host names you open Hoard by, besides IPs and local names like nas or nas.local.
# Comma separated; *.example.com works. Needed for a reverse proxy domain, e.g. hoard.example.com
ALLOWED_HOSTS=

# Behind a reverse proxy: its address as Hoard sees it (IPs or networks, comma separated), so the
# password lockout tells visitors apart. For a proxy on the Docker host, e.g. 172.16.0.0/12.
TRUSTED_PROXIES=

# Which address and port to publish on. 0.0.0.0 = every network the server is on.
BIND_ADDRESS=0.0.0.0
PORT=8080

# Downloads that run at once (the rest wait), and space always kept free on the models disk.
MAX_PARALLEL_DOWNLOADS=2
MIN_FREE_GB=2
